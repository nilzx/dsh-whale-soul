{
  "name": "dsh-whale-soul",
  "version": "0.1.5",
  "description": "A soul for DeepSeek Harness: an in-character Whale Chan agent preset with layered long-term memory and dream-like consolidation.",
  "type": "module",
  "license": "MIT",
  "author": "Nilzx",
  "homepage": "https://github.com/nilzx/dsh-whale-soul#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nilzx/dsh-whale-soul.git"
  },
  "bugs": {
    "url": "https://github.com/nilzx/dsh-whale-soul/issues"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./body": "./src/body/index.js",
    "./package.json": "./package.json",
    "./locale": "./src/locale.js",
    "./client": "./src/client.js",
    "./persona": "./src/persona/plugin.js",
    "./memory": "./src/memory/v2/index.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs",
    "assets"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "agent-preset",
    "persona",
    "memory",
    "companion",
    "whale",
    "whale-chan"
  ],
  "icon": "assets/icon.png",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:client": "node src/build-client.js",
    "test": "node --test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build:client && npm run build:bundle && npm test",
    "build:bundle": "node src/build-bundle.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-agent-preset",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "dsh-plugin": {
    "category": "identity",
    "displayName": "Whale Chan Soul"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent-preset": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-sandbox": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-bash-sandbox": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-tool-fs": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-tool-bash": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-tool-fs-search": ">=0.2.1-rc.3 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-bash-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-bash": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-fs-search": {
      "optional": true
    }
  }
}
